{
  "schema": "comfy-quest-experience/v2",
  "id": "slayers-cold-shot",
  "title": "Cold Shot",
  "entry_stage": "hunt",
  "prerequisites": [
    "slayers-air-drop"
  ],
  "stages": [
    {
      "id": "hunt",
      "entry_actions": [
        {
          "id": "message-briefing",
          "type": "message",
          "text": "Cold Shot: finish the Drake with a thrown spear."
        }
      ],
      "transitions": [
        {
          "id": "drake-thrown-spear",
          "priority": 100,
          "when": {
            "op": "EVENT",
            "event": "kill",
            "target": "$enemy_drake",
            "where": {
              "weapon_skill": "Spears",
              "projectile": "true"
            }
          },
          "actions": [
            {
              "id": "message-complete",
              "type": "message",
              "text": "Cold Shot answered. The Slayers' Signature Hunt is complete."
            }
          ],
          "outcome": "complete"
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "default",
      "experience_id": "slayers-cold-shot",
      "target_kinds": [
        "sign"
      ]
    }
  ]
}
