<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\ComfyQuestRuntime\LiveTest\manifest.json" Link="LiveTest\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ComfyQuestRuntime\LiveTest\experiences\omen-inscription.json" Link="LiveTest\experiences\omen-inscription.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComfyQuestContracts\ComfyQuestContracts.csproj" />
  </ItemGroup>

  <!-- The quest-glue types (TrackedQuest/QuestEvent/QuestViewLoader/QuestTriggerEvaluator/
       QuestEventCatalog/QuestAuthoring) are declared namespace ComfyNetworkSense but now live at
       ..\ComfyQuestContracts\ModGlue\ (they ship cross-repo as the Comfy.Quest.Contracts package's
       contentFiles). Linked directly here, same as the lab's own csproj, so these tests exercise
       the exact compiled-in source rather than a separately-built DLL. The ComfyQuestLab Core
       links below are the lab logic itself (file-content-in, no Unity, no Valheim) — this is the
       whole reason these tests can run without a game install. -->
  <ItemGroup>
    <Compile Include="..\ComfyQuestLab\Core\BlueprintFile.cs" Link="BlueprintFile.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabCaptureContract.cs" Link="LabCaptureContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabPanelLayout.cs" Link="LabPanelLayout.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabDemoReadiness.cs" Link="LabDemoReadiness.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\TrackedQuest.cs" Link="TrackedQuest.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestEvent.cs" Link="QuestEvent.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestViewLoader.cs" Link="QuestViewLoader.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestTriggerEvaluator.cs" Link="QuestTriggerEvaluator.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestEventCatalog.g.cs" Link="QuestEventCatalog.g.cs" />
    <Compile Include="..\ComfyQuestContracts\ModGlue\QuestAuthoring.cs" Link="QuestAuthoring.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestSet.cs" Link="LabQuestSet.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestAdvisor.cs" Link="LabQuestAdvisor.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabQuestSeed.cs" Link="LabQuestSeed.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabCreatureNaming.cs" Link="LabCreatureNaming.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabActionDedupe.cs" Link="LabActionDedupe.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabBatchContract.cs" Link="LabBatchContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabGalleryOriginContract.cs" Link="LabGalleryOriginContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabScenarioContract.cs" Link="LabScenarioContract.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabRuntimeProfile.cs" Link="LabRuntimeProfile.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabTreeRecoveryContract.cs" Link="LabTreeRecoveryContract.cs" />
    <!-- Generated, and Unity-free by construction (plain floats and strings) — linked so the
         seed can be asserted against the gallery the seed is meant to be practised in. It names
         its categories from LabEvents, which is Unity-free for the same reason. -->
    <Compile Include="..\ComfyQuestLab\Core\LabEvents.cs" Link="LabEvents.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabEventArchive.cs" Link="LabEventArchive.cs" />
    <Compile Include="..\ComfyQuestLab\Core\LabGalleryPlan.g.cs" Link="LabGalleryPlan.g.cs" />
  </ItemGroup>

</Project>
