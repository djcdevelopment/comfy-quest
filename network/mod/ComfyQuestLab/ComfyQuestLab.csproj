<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ComfyQuestLab</AssemblyName>
    <RootNamespace>ComfyQuestLab</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- SourceLink maps to the containing Git commit and therefore changes the DLL's
         debug-directory checksum after documentation-only commits. Quest Lab ships one
         SHA-verified DLL directly, so unchanged plugin source must rebuild to unchanged
         bytes; local source paths remain deterministic through PathMap below. -->
    <EnableSourceLink>false</EnableSourceLink>
    <!-- The quest contract now arrives via contentFiles from the NuGet global-packages cache
         (a per-machine path under the user profile, not a repo-relative one). Map it too, so the
         SHA-verified single-DLL lane stays deterministic across machines/profiles, not just across
         directories inside this repo. -->
    <PathMap Condition="'$(PathMap)' == ''">$(MSBuildProjectDirectory)=C:\src\ComfyQuestLab,$(NuGetPackageRoot)=C:\nuget\</PathMap>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <PluginOutputPath Condition="'$(PluginOutputPath)' == ''">$(ValheimDir)\BepInEx\plugins</PluginOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimDir)\valheim_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The quest contract (TrackedQuest/QuestEvent/QuestViewLoader/QuestTriggerEvaluator/
       QuestEventCatalog/QuestAuthoring) now travels as the Comfy.Quest.Contracts NuGet package
       (network/mod/ComfyQuestContracts/ModGlue/), consumed here via contentFiles so the lab keeps
       compiling the IDENTICAL source into its own single BepInEx DLL — no assembly reference, no
       ProjectReference; see the PackageReference below and PD-9 (repo split). Both namespaces are
       ComfyNetworkSense, so the lab refers to the quest types by their real names. That is
       intentional: if this ever needs an adapter, the contract has drifted and the fix is
       upstream, not here.

       NOT linked yet: GameplayEventTypes. It shares GameplayEventProducer.cs with a
       353-line Unity- and BepInEx-dependent class, so linking it would drag the whole
       producer in. Extracting it to its own file is a small change to the shipping mod
       and owes a roadmap note; until then the lab declares its own copy in LabEvents
       and a test will pin the two together. -->
  <ItemGroup>
    <PackageReference Include="Comfy.Quest.Contracts" Version="[0.1.0-local]"
                       IncludeAssets="contentFiles" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CHANGELOG.md" />
    <None Include="djcdevelopment.valheim.comfyquestlab.cfg" />
    <None Include="manifest.json" />
    <None Include="README.md" />
  </ItemGroup>

  <!-- Same two guards as ComfyNetworkSense, for the same reason: an unguarded auto-copy
       once replaced a pinned DLL mid-program. The path must exist AND you must ask. -->
  <Target Name="CopyAssembly" AfterTargets="Build"
          Condition="Exists('$(PluginOutputPath)') And '$(ComfyCopyToPlugins)' == 'true'">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(PluginOutputPath)" />
  </Target>
</Project>
