{
  "schema": "comfy-quest-experience/v1",
  "id": "omen-cooperative-ritual",
  "title": "Two Voices, One Rune",
  "entry_stage": "await-peer-shout",
  "stages": [
    {
      "id": "await-peer-shout",
      "transitions": [
        {
          "id": "peer-wakes-charm",
          "priority": 100,
          "when": {
            "op": "EVENT",
            "event": "chat_received",
            "target": "shout",
            "where": { "actor_role": "peer" }
          },
          "actions": [
            { "id": "message-peer-heard", "type": "message", "text": "A distant voice wakes the Charm." }
          ],
          "next_stage": "await-host-sign"
        }
      ]
    },
    {
      "id": "await-host-sign",
      "transitions": [
        {
          "id": "host-answers-with-rune",
          "priority": 100,
          "when": {
            "op": "EVENT",
            "event": "piece_placed",
            "target": "sign",
            "where": { "actor_role": "listen_host" }
          },
          "actions": [
            { "id": "message-ritual-complete", "type": "message", "text": "The host raises the answering rune. The ritual is complete." }
          ],
          "outcome": "complete"
        }
      ]
    }
  ],
  "bindings": [
    { "id": "default", "experience_id": "omen-cooperative-ritual", "target_kinds": ["sign"] }
  ]
}
