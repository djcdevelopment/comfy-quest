<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AssemblyName>Comfy.Quest.Studio</AssemblyName>
    <RootNamespace>Comfy.Quest.Studio</RootNamespace>
    <!-- The workflow overrides this only after the matching Contracts package has
         been downloaded back from NuGet.org and inspected. -->
    <QuestContractsVersion Condition="'$(QuestContractsVersion)' == ''">[0.5.0-local]</QuestContractsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Quest Studio maps ASP.NET Core minimal-API endpoints (WebApplication/HttpRequest/Results)
         but is not itself a web host — a plain class library + FrameworkReference keeps it a thin,
         packable seam. Companion (Microsoft.NET.Sdk.Web) stays the actual host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Game.Companion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cross-repo boundary (comfy-quest owns Comfy.Quest.Contracts): the compiled assembly only
         (ExcludeAssets="contentFiles" — Studio needs ExperienceContract/QuestPackContent/etc,
         not the mod's single-DLL ModGlue source). -->
    <PackageReference Include="Comfy.Quest.Contracts" Version="$(QuestContractsVersion)"
                      ExcludeAssets="contentFiles" />
  </ItemGroup>

  <!-- Companion stays the host (implements IQuestStudioHost); .questpack files remain
       the versioned Runtime handoff. This project is intentionally self-contained so it
       does not inherit build or package versions from the platform repository. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Comfy.Quest.Studio</PackageId>
    <Version>0.5.0-local</Version>
    <Title>Comfy Quest Studio</Title>
    <Authors>djcdevelopment</Authors>
    <PackageProjectUrl>https://github.com/djcdevelopment/comfy-quest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/djcdevelopment/comfy-quest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <PackageTags>quest;valheim;authoring;studio</PackageTags>
    <Description>Quest Studio: the loopback Workbench surface for authoring, certifying, and publishing quest experiences to Runtime via .questpack. Carved from Game.Companion; the host (Companion) implements IQuestStudioHost.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
